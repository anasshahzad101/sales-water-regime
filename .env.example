# Copy to .env.local for local work, and add the same keys in Vercel → Project → Settings → Environment Variables.

# --- Session signing key (required in production). At least 32 random characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Live database: Hostinger MariaDB / MySQL.
# Leave everything below empty to use the local JSON file (.data/db.json) during development.
# Either a single URL (URL-encode special characters in the password, e.g. @ → %40):
DATABASE_URL=
# DATABASE_URL=mysql://u123456789_sales:YOUR_PASSWORD@srv1234.hstgr.io:3306/u123456789_saleshub
# ...or the separate parts instead of DATABASE_URL:
# DB_HOST=srv1234.hstgr.io
# DB_PORT=3306
# DB_USER=u123456789_sales
# DB_PASSWORD=
# DB_NAME=u123456789_saleshub

# Optional
# DB_SSL=true                 # if your host requires TLS
# DATABASE_POOL_MAX=3         # connections per server instance (shared hosting limits these)
# SEED_DEFAULT_PASSWORD=      # temporary password for the starting accounts (default ChangeMe123!)
